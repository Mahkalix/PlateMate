{
  "name": "platemate-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "sass --no-source-map scss/main.scss:public/maintenance.css scss/community.scss:public/whatsapp/styles.css",
    "watch": "sass --watch --no-source-map scss/main.scss:public/maintenance.css scss/community.scss:public/whatsapp/styles.css",
    "check:css": "npm run build && git -C .. diff --exit-code -- frontend/public/maintenance.css frontend/public/whatsapp/styles.css",
    "format": "prettier --write 'scss/**/*.scss'",
    "format:check": "prettier --check 'scss/**/*.scss'"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "sass": "1.105.0"
  }
}
