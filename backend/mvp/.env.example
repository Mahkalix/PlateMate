DATABASE_URL=postgres://platemate:platemate@localhost:5432/platemate
PORT=3001
# Générer 32 octets aléatoires pour chaque environnement
JWT_SECRET=
# Auth0 Regular Web Application, connexion Database avec email et mot de passe
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:3001/auth/callback
AUTH0_CONNECTION=Username-Password-Authentication
# Compose local : mot de passe PostgreSQL aléatoire en hexadécimal
MVP_DB_PASSWORD=
# Facultatif pour les autres routes. Utiliser exclusivement le mode test Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
APP_ORIGIN=http://localhost:8080
