{
  "name": "platemate-matching-api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "migrate": "tsx --env-file-if-exists=.env src/db.ts migrate",
    "seed": "tsx --env-file-if-exists=.env src/db.ts seed",
    "seed": "tsx --env-file-if-exists=.env src/db.ts seed",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:security": "vitest run test/security",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "jose": "^6.2.15",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "stripe": "^20.4.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
