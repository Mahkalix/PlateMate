{
  "name": "platemate-api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "migrate": "node --env-file=.env src/server.js --migrate",
    "worker": "node --env-file=.env src/worker.js",
    "worker:dev": "node --env-file=.env src/worker.js --loop",
    "test": "node --test",
    "test:integration": "node --env-file=.env.test --test test/integration.test.js",
    "demo": "node scripts/demo.mjs",
    "demo:stripe": "node scripts/demo.mjs --checkout"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-oauth2-jwt-bearer": "^1.10.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.16.0",
    "sharp": "^0.35.5",
    "stripe": "^20.0.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jose": "^6.2.12"
  }
}
